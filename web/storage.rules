rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /bakeries/{bakeryId}/{allPaths=**} {
      allow read, write: if isAdmin()
        || (request.auth != null
          && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.bakeryId == bakeryId);
    }
  }
}
