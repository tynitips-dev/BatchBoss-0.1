rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function ownsBakery(bakeryId) {
      return signedIn() && userDoc().data.bakeryId == bakeryId;
    }

    match /users/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid;
      allow read, update: if signedIn()
        && (request.auth.uid == uid || isAdmin());
      allow delete: if false;
    }

    match /bakeries/{bakeryId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow read, update: if ownsBakery(bakeryId) || isAdmin();
      allow delete: if false;

      match /members/{uid} {
        allow create: if signedIn() && request.auth.uid == uid;
        allow read: if ownsBakery(bakeryId) || isAdmin();
        allow update, delete: if isAdmin()
          || (ownsBakery(bakeryId) && request.auth.uid == uid);
      }

      match /{document=**} {
        allow read, create, update, delete: if ownsBakery(bakeryId) || isAdmin();
      }
    }

    match /deletionRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
