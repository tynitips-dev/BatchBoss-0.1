# Copy these lines into functions/.env.batch-boss-android; preserve existing settings.
# Start with test plan codes created using the Paystack test dashboard.
PAYSTACK_ENABLED=true
PAYSTACK_MONTHLY_PLAN_CODE=PLN_REPLACE_WITH_MONTHLY_CODE
PAYSTACK_ANNUAL_PLAN_CODE=PLN_REPLACE_WITH_ANNUAL_CODE
# PAYSTACK_SECRET_KEY belongs in Firebase Secret Manager, NOT this file.
