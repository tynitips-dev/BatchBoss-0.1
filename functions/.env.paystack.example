# Copy these lines into functions/.env.batch-boss-android; preserve existing settings.
# Start with test plan codes created using the Paystack test dashboard.
PAYSTACK_ENABLED=true
PAYSTACK_MONTHLY_PLAN_CODE=PLN_REPLACE_WITH_MONTHLY_CODE
PAYSTACK_ANNUAL_PLAN_CODE=PLN_REPLACE_WITH_ANNUAL_CODE
# PAYSTACK_SECRET_KEY belongs in Firebase Secret Manager, NOT this file.

# Enable only in the deployed functions environment when ready for live Marketplace checkout.
PAYSTACK_MARKETPLACE_ENABLED=false

# Additional plans: confirm exact live plan codes and billing intervals before enabling.
PAYSTACK_WEEKLY_ENABLED=false
PAYSTACK_WEEKLY_PLAN_CODE=PLN_REPLACE_WEEKLY
PAYSTACK_DIRECTORY_LISTING_ENABLED=false
PAYSTACK_DIRECTORY_LISTING_PLAN_CODE=PLN_REPLACE_DIRECTORY
PAYSTACK_FULL_SUITE_ENABLED=false
PAYSTACK_FULL_SUITE_PLAN_CODE=PLN_REPLACE_FULL_SUITE
