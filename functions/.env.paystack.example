# Copy these lines into functions/.env.batch-boss-android; preserve existing settings.
# Start with test plan codes created using the Paystack test dashboard.
PAYSTACK_ENABLED=true
PAYSTACK_MONTHLY_PLAN_CODE=PLN_REPLACE_WITH_MONTHLY_CODE
PAYSTACK_ANNUAL_PLAN_CODE=PLN_REPLACE_WITH_ANNUAL_CODE
# PAYSTACK_SECRET_KEY belongs in Firebase Secret Manager, NOT this file.

# Promotional Paystack plan codes. Leave blank until matching plans are created and verified.
# Monthly launch: R99.00 (9900 cents) per month.
PAYSTACK_MONTHLY_PROMO_PLAN_CODE=
# Annual launch: R990.00 (99000 cents) first year. Normal renewals use PAYSTACK_ANNUAL_PLAN_CODE (R1199).
PAYSTACK_ANNUAL_PROMO_PLAN_CODE=
# IMPORTANT: Having plan codes set does not activate billing. Promo feature flags stay false until verified.
