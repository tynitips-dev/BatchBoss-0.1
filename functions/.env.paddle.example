# Server-side Firebase Paddle parameters. Keep disabled until integration tests pass.
# Configure PADDLE_API_KEY and PADDLE_WEBHOOK_SECRET with Firebase Secret Manager,
# not this file, GitHub source, VITE_ variables, or chat. Use different secrets per environment.
PADDLE_ENVIRONMENT=sandbox
PADDLE_WEBHOOK_ENABLED=false
PADDLE_PROVISION_ENABLED=false
PADDLE_PORTAL_ENABLED=false
# Map verified environment-specific price IDs to product IDs and billing intervals.
# JSON example shape: {"pri_REPLACE":{"productId":"pro_REPLACE","interval":"month"}}
PADDLE_PRO_PRICE_MAP={}

# Pilot only until the complete lifecycle is verified (no public enable switch yet).
PADDLE_CHECKOUT_ENABLED=false
PADDLE_TEST_UID=
# Public Paddle.js client token (test_ or live_ must match environment), not API key.
PADDLE_CLIENT_TOKEN=

# Additional listing subscriptions require explicit plan keys in the verified price map.
# E.g. {"pri_REPLACE":{"productId":"pro_REPLACE","interval":"month","plan":"finder"}}
# or plan:"full_suite". Do not enable until listing publication and live tests pass.
PADDLE_LISTING_SUBSCRIPTIONS_ENABLED=false

# Separate one-time listing fee; never use a recurring product price.
PADDLE_MARKETPLACE_ENABLED=false
PADDLE_MARKETPLACE_PRICE_ID=
PADDLE_MARKETPLACE_PRODUCT_ID=

# Launch offers use the standard recurring price plus an exact, finite Paddle discount.
# Values require verified discount IDs, end timestamp, and paid-period count; annual=1.
# Example shape: {"GB":{"monthly_launch":{"discountId":"dsc_REPLACE","endsAt":"RFC3339","periods":1}}}
PADDLE_LAUNCH_ENABLED=false
PADDLE_LAUNCH_DISCOUNT_MAP={}

# Explicit public rollout gates. Keep false until sandbox, live pilot and QA pass.
PADDLE_PUBLIC_CHECKOUT_ENABLED=false
BATCHBOSS_GLOBAL_SIGNUP_ENABLED=false
